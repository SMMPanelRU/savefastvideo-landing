---
// SaveFastVideo Mini App v2.
// Внутри Telegram: вход по initData → /api/*. Вне Telegram: заглушка (+ вход через бота).
import { siInstagram, siTiktok, siYoutube, siX, siVk, siOdnoklassniki, siPinterest, siReddit, siVimeo, siFacebook, siTwitch, siDailymotion, siSoundcloud, siBilibili } from 'simple-icons';
const tgAnalyticsToken = import.meta.env.PUBLIC_TG_ANALYTICS_TOKEN || '';
const ico = (i: { path: string; hex: string }) => ({ p: i.path, c: i.hex === '000000' ? '#111827' : '#' + i.hex });
const BRANDS = {
  Instagram: ico(siInstagram), TikTok: ico(siTiktok), YouTube: ico(siYoutube), 'Twitter/X': ico(siX),
  VK: ico(siVk), OK: ico(siOdnoklassniki), Pinterest: ico(siPinterest), Reddit: ico(siReddit),
  Vimeo: ico(siVimeo), Facebook: ico(siFacebook), Twitch: ico(siTwitch), Dailymotion: ico(siDailymotion),
  SoundCloud: ico(siSoundcloud), Bilibili: ico(siBilibili),
};
const PLATFORMS = ['Instagram', 'TikTok', 'YouTube', 'VK', 'Twitter/X', 'OK', 'Pinterest', 'Reddit', 'Vimeo'];
const PNAMES: Record<string, string> = { 'Twitter/X': 'X', VK: 'ВКонтакте', OK: 'Одноклассники' };
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
    <meta name="theme-color" content="#f2f4f8" />
    <title>SaveFastVideo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="https://telegram.org/js/telegram-web-app.js"></script>
    <style is:global>
      :root {
        --bg: #f2f4f8; --bg-soft: #ffffff; --bg-elev: #f5f7fb; --bg-elev-2: #eef2f9;
        --fg: #0f1729; --fg-muted: #6b7489; --fg-faint: #9aa3b5;
        --border: #e7ecf4; --border-strong: #cfd7e4;
        --accent: #2563eb; --accent-hover: #1d4fd8; --on-accent: #ffffff; --accent-soft: #eaf1fe;
        --danger: #ef4444; --danger-soft: #fdecec; --success: #10a64a; --success-soft: #e7f6ec; --warning: #d97706; --warning-soft: #fdf3e2;
        --hero-grad: linear-gradient(140deg, #5b8cff 0%, #2563eb 52%, #1b46c9 100%);
        --shadow-1: 0 1px 2px rgba(15, 23, 41, .05); --shadow-2: 0 8px 24px rgba(15, 23, 41, .08);
        --shadow-accent: 0 10px 24px rgba(37, 99, 235, .28);
        --r: 18px; --r-sm: 14px;
        --safe-top: env(safe-area-inset-top, 0px); --safe-bottom: env(safe-area-inset-bottom, 0px);
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: var(--bg); color: var(--fg); }
      body { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', Inter, 'Segoe UI', Roboto, sans-serif; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
      button, input { font: inherit; color: inherit; }
      button { cursor: pointer; }
      svg.i { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

      .app { max-width: 520px; margin: 0 auto; padding: calc(14px + var(--safe-top)) 16px calc(112px + var(--safe-bottom)); min-height: 100vh; }
      .app[hidden], [hidden] { display: none !important; }
      .screen { animation: in .22s ease; }
      @keyframes in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

      /* hero */
      .hero { position: relative; border-radius: 22px; padding: 18px 18px 16px; overflow: hidden; margin-bottom: 16px; background: var(--hero-grad); color: #fff; box-shadow: var(--shadow-accent); }
      .hero::before { content: ''; position: absolute; width: 220px; height: 220px; border-radius: 50%; right: -60px; top: -90px; background: radial-gradient(circle, rgba(255,255,255,.4), transparent 70%); opacity: .55; }
      .hero::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 80% at 0% 100%, rgba(0,0,0,.16), transparent 60%); }
      .hero > * { position: relative; z-index: 1; }
      .hero__top { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
      .hero__ava { width: 34px; height: 34px; border-radius: 10px; background: rgba(255,255,255,.25); display: grid; place-items: center; font-weight: 800; }
      .hero__name { flex: 1; min-width: 0; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .hero__badge { font-size: 12px; font-weight: 800; background: rgba(255,255,255,.28); padding: 4px 11px; border-radius: 999px; border: 0; color: #fff; }
      .hero__lbl { font-size: 13px; font-weight: 700; opacity: .82; }
      .hero__big { font-size: 40px; font-weight: 900; letter-spacing: -.03em; line-height: 1.05; margin-top: 2px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
      .hero__pill { font-size: 13px; font-weight: 800; background: rgba(255,255,255,.22); padding: 4px 10px; border-radius: 999px; }
      .hq { display: flex; gap: 8px; margin-top: 16px; }
      .hq button { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 700; color: #fff; background: none; border: 0; padding: 0; transition: transform .08s ease; }
      .hq button:active { transform: scale(.94); }
      .hq__c { width: 46px; height: 46px; border-radius: 50%; background: rgba(255,255,255,.22); border: 1px solid rgba(255,255,255,.35); display: grid; place-items: center; }

      /* headers & sections */
      .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 6px 4px 4px; }
      .head h1 { margin: 0; font-size: 26px; line-height: 1.1; font-weight: 800; letter-spacing: -.02em; }
      .head__sub { margin: 4px 4px 16px; color: var(--fg-muted); font-size: 13.5px; }
      .stitle { display: flex; align-items: center; justify-content: space-between; margin: 22px 4px 10px; font-size: 17px; font-weight: 800; letter-spacing: -.015em; }
      .stitle a, .stitle button { font-size: 13px; font-weight: 700; color: var(--accent); background: var(--accent-soft); border: 0; border-radius: 999px; padding: 6px 12px; text-decoration: none; }
      .card { background: var(--bg-soft); border: 1px solid var(--border); border-radius: var(--r); box-shadow: var(--shadow-1); overflow: hidden; }
      .card--pad { padding: 16px; }

      /* download form */
      .field { display: flex; align-items: center; gap: 8px; background: var(--bg-elev); border: 1.5px solid var(--border); border-radius: var(--r-sm); padding: 4px 4px 4px 14px; transition: border-color .15s, background .15s; }
      .field:focus-within { border-color: var(--accent); background: #fff; }
      .field input { flex: 1; min-width: 0; border: 0; background: none; outline: 0; font-size: 15.5px; padding: 11px 0; }
      .field input::placeholder { color: var(--fg-faint); }
      .field__btn { height: 40px; padding: 0 12px; border-radius: 11px; border: 0; background: var(--accent-soft); color: var(--accent); font-size: 13.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; }
      .field__btn svg.i { width: 18px; height: 18px; }
      .lbl { margin: 14px 2px 8px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-muted); }
      .seg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; background: var(--bg-elev-2); border-radius: 12px; padding: 4px; }
      .seg button { height: 38px; border: 0; border-radius: 9px; background: none; font-size: 14px; font-weight: 700; color: var(--fg-muted); transition: background .15s, color .15s, box-shadow .15s; }
      .seg button[aria-pressed="true"] { background: #fff; color: var(--fg); box-shadow: var(--shadow-1); }
      .btn { width: 100%; height: 52px; margin-top: 14px; border: 0; border-radius: var(--r-sm); background: var(--accent); color: var(--on-accent); font-size: 16px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-shadow: var(--shadow-accent); transition: transform .08s ease, background .15s, opacity .15s; }
      .btn:active { transform: scale(.98); }
      .btn:disabled { opacity: .6; box-shadow: none; }
      .btn--ghost { background: var(--accent-soft); color: var(--accent); box-shadow: none; }
      .btn--danger { background: var(--danger-soft); color: var(--danger); box-shadow: none; }
      .hint { margin: 10px 2px 0; font-size: 13px; color: var(--fg-muted); text-align: center; }

      /* cells */
      .cell { display: flex; align-items: center; gap: 12px; width: 100%; padding: 13px 14px; background: transparent; border: 0; text-align: left; position: relative; text-decoration: none; color: var(--fg); }
      .cell + .cell::before { content: ''; position: absolute; top: 0; left: 62px; right: 0; height: 1px; background: var(--border); }
      button.cell:active, a.cell:active { background: var(--accent-soft); }
      .cell__ic { width: 38px; height: 38px; border-radius: 11px; background: var(--bg-elev-2); display: grid; place-items: center; flex: none; color: var(--accent); }
      .cell__ic svg { width: 20px; height: 20px; }
      .cell__ic--brand svg { width: 19px; height: 19px; }
      .cell__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
      .cell__t { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .cell__s { font-size: 12.5px; color: var(--fg-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .cell__end { flex: none; color: var(--fg-faint); display: flex; align-items: center; gap: 8px; }
      .cell__end svg.i { width: 18px; height: 18px; }
      .pill { display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
      .pill--ok { background: var(--success-soft); color: var(--success); }
      .pill--fail { background: var(--danger-soft); color: var(--danger); }
      .pill--warn { background: var(--warning-soft); color: var(--warning); }
      .pill--mute { background: var(--bg-elev-2); color: var(--fg-muted); }
      .day { margin: 18px 6px 8px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-muted); }

      /* chips */
      .chips { display: flex; gap: 8px; overflow-x: auto; margin: 0 -16px 4px; padding: 2px 16px 6px; scrollbar-width: none; }
      .chips::-webkit-scrollbar { display: none; }
      .chip { flex: none; height: 36px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--border); background: #fff; font-size: 14px; font-weight: 700; color: var(--fg); box-shadow: var(--shadow-1); }
      .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: var(--shadow-accent); }
      .chip b { margin-left: 4px; opacity: .7; }

      /* platforms */
      .plats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      .plat { background: #fff; border: 1px solid var(--border); border-radius: var(--r-sm); padding: 14px 6px 12px; display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600; box-shadow: var(--shadow-1); }
      .plat__ic { width: 40px; height: 40px; border-radius: 12px; background: var(--bg-elev); display: grid; place-items: center; }
      .plat__ic svg { width: 21px; height: 21px; }

      /* stats */
      .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      .tile { background: #fff; border: 1px solid var(--border); border-radius: var(--r-sm); padding: 14px 12px; box-shadow: var(--shadow-1); }
      .tile__v { font-size: 24px; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
      .tile__l { margin-top: 4px; font-size: 12px; color: var(--fg-muted); font-weight: 600; line-height: 1.25; }
      .tile--ok .tile__v { color: var(--success); } .tile--fail .tile__v { color: var(--danger); }
      .bars { padding: 6px 14px 14px; }
      .bar { display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 10px; margin-top: 10px; font-size: 13.5px; font-weight: 600; }
      .bar__ic svg { width: 18px; height: 18px; }
      .bar__track { height: 8px; border-radius: 999px; background: var(--bg-elev-2); overflow: hidden; }
      .bar__fill { height: 100%; border-radius: 999px; background: var(--accent); }

      .ch-wrap { position: relative; flex: none; }
      .ch-ava { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; display: grid; place-items: center; background: var(--hero-grad); color: #fff; font-weight: 800; font-size: 16px; }
      .ch-warn { position: absolute; right: -3px; bottom: -3px; width: 18px; height: 18px; border-radius: 50%; background: var(--warning); color: #fff; font-size: 12px; font-weight: 900; display: grid; place-items: center; border: 2px solid #fff; }
      /* switch */
      .sw { position: relative; width: 51px; height: 31px; flex: none; border: 0; padding: 0; border-radius: 999px; background: #d6dbe5; transition: background .2s; }
      .sw::after { content: ''; position: absolute; top: 2px; left: 2px; width: 27px; height: 27px; border-radius: 50%; background: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.18); transition: transform .22s cubic-bezier(.2,.7,.2,1); }
      .sw[aria-checked="true"] { background: var(--accent); }
      .sw[aria-checked="true"]::after { transform: translateX(20px); }

      /* empty */
      .empty { padding: 34px 20px; text-align: center; color: var(--fg-muted); font-size: 14px; }
      .empty__ic { width: 56px; height: 56px; margin: 0 auto 12px; border-radius: 16px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; }
      .empty b { display: block; color: var(--fg); font-size: 16px; margin-bottom: 4px; }

      /* skeleton */
      .sk { border-radius: 10px; background: linear-gradient(90deg, #e9edf4 25%, #f3f5f9 50%, #e9edf4 75%); background-size: 200% 100%; animation: sk 1.2s infinite; }
      @keyframes sk { to { background-position: -200% 0; } }

      /* bottom nav (стандарт экосистемы) */
      .nav-fade { position: fixed; left: 0; right: 0; bottom: 0; height: calc(120px + var(--safe-bottom)); pointer-events: none; z-index: 40; background: linear-gradient(to bottom, rgba(242,244,248,0), var(--bg) 70%); }
      .nav { position: fixed; left: 16px; right: 16px; bottom: max(var(--safe-bottom), 12px); max-width: 488px; margin: 0 auto; z-index: 50; display: flex; align-items: center; gap: 4px; background: rgba(255,255,255,.96); backdrop-filter: saturate(180%) blur(16px); -webkit-backdrop-filter: saturate(180%) blur(16px); border: 1px solid var(--border); border-radius: 999px; padding: 6px; box-shadow: 0 10px 30px rgba(15,23,41,.12); }
      .nav button { flex: 1 1 0; min-width: 44px; min-height: 46px; display: flex; align-items: center; justify-content: center; gap: 7px; color: var(--fg-muted); font-size: 13.5px; font-weight: 700; padding: 0 10px; border: 0; background: none; border-radius: 999px; transition: color .2s, background .2s, flex-grow .25s cubic-bezier(.2,.6,.2,1); }
      .nav button:active { transform: scale(.94); }
      .nav span { display: none; white-space: nowrap; }
      .nav button[aria-current="page"] { flex-grow: 2.2; color: #fff; background: var(--accent); box-shadow: var(--shadow-accent); }
      .nav button[aria-current="page"] span { display: inline; }
      @media (prefers-reduced-motion: reduce) { .nav button, .screen { transition: none; animation: none; } }

      /* sheet */
      .sheet-bg { position: fixed; inset: 0; z-index: 80; background: rgba(15,23,41,.38); opacity: 0; transition: opacity .2s; }
      .sheet-bg.on { opacity: 1; }
      .sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; max-width: 520px; margin: 0 auto; background: var(--bg); border-radius: 22px 22px 0 0; padding: 10px 16px calc(20px + var(--safe-bottom)); transform: translateY(100%); transition: transform .26s cubic-bezier(.2,.7,.2,1); max-height: 88vh; overflow: auto; }
      .sheet.on { transform: none; }
      .sheet__grab { width: 38px; height: 5px; border-radius: 999px; background: var(--border-strong); margin: 0 auto 14px; }
      .sheet h3 { margin: 0 4px 4px; font-size: 20px; font-weight: 800; }
      .sheet p.sub { margin: 0 4px 14px; font-size: 13.5px; color: var(--fg-muted); line-height: 1.45; }
      .sheet .field + .lbl { margin-top: 14px; }
      .sheet .field { background: #fff; }

      /* toast */
      .toast { position: fixed; left: 50%; top: calc(14px + var(--safe-top)); z-index: 100; transform: translate(-50%, calc(-100% - 40px)); visibility: hidden; max-width: calc(100% - 32px); padding: 12px 16px; border-radius: 14px; background: #0f1729; color: #fff; font-size: 14px; font-weight: 600; box-shadow: var(--shadow-2); transition: transform .28s cubic-bezier(.2,.7,.2,1); }
      .toast.on { transform: translate(-50%, 0); visibility: visible; }
      .toast--err { background: var(--danger); }

      .spin { width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid rgba(255,255,255,.4); border-top-color: #fff; animation: rot .7s linear infinite; }
      @keyframes rot { to { transform: rotate(360deg); } }
      .foot { margin: 26px 0 0; text-align: center; font-size: 12px; color: var(--fg-faint); }

      /* ── Заглушка вне Telegram (светлая тема, как приложение) ── */
      body.is-stub { background: var(--bg); }
      .stub { position: relative; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; align-items: center; padding: 28px 16px calc(28px + var(--safe-bottom)); }
      .stub__glow { display: none; }
      .stub__brand { display: inline-flex; align-items: center; gap: 10px; color: var(--fg); text-decoration: none; font-weight: 800; font-size: 17px; letter-spacing: -.01em; }
      .stub__brand b { font-weight: 800; }
      .stub__mark { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 9px; background: var(--hero-grad); color: #fff; }
      .stub__body { flex: 1; width: 100%; max-width: 440px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 0; }
      .stub__icon { width: 84px; height: 84px; display: grid; place-items: center; margin-bottom: 24px; border-radius: 24px; background: var(--hero-grad); color: #fff; box-shadow: var(--shadow-accent); }
      .stub__eyebrow { margin: 0 0 8px; color: var(--accent); font-size: 14px; font-weight: 700; }
      .stub__title { margin: 0 0 12px; font-size: clamp(28px, 7vw, 36px); line-height: 1.1; font-weight: 800; letter-spacing: -.025em; }
      .stub__lede { margin: 0 0 28px; color: var(--fg-muted); font-size: 16px; line-height: 1.5; }
      .stub__cta { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 54px; border-radius: var(--r-sm); background: var(--accent); color: #fff; text-decoration: none; font-size: 16px; font-weight: 700; box-shadow: var(--shadow-accent); transition: transform .08s ease; }
      .stub__cta:active { transform: scale(.98); }
      .stub__alt { margin-top: 16px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; color: var(--fg-faint); font-size: 14px; }
      .stub__alt a { color: var(--accent); text-decoration: none; font-weight: 600; }
      .stub__web { margin-top: 24px; background: none; border: 0; padding: 8px; color: var(--fg-muted); font-size: 13.5px; text-decoration: underline; text-underline-offset: 3px; }
      .stub__web:disabled { opacity: .7; text-decoration: none; }
      .stub .auth-status { margin-top: 10px; font-size: 13px; color: var(--fg-muted); line-height: 1.5; min-height: 18px; }
      .stub__back { color: var(--fg-muted); font-size: 13.5px; text-decoration: none; }
    </style>
  </head>
  <body>
    <!-- ЗАГЛУШКА ВНЕ TELEGRAM: Mini App живёт только внутри Telegram -->
    <section id="auth" class="stub" hidden>
      <div class="stub__glow" aria-hidden="true"></div>
      <a class="stub__brand" href="/" aria-label="SaveFastVideo — на главную">
        <span class="stub__mark"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"/></svg></span>
        <span>SaveFastVideo</span>
      </a>
      <div class="stub__body">
        <div class="stub__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
        </div>
        <p class="stub__eyebrow">Telegram Mini App</p>
        <h1 class="stub__title">Приложение работает<br/>в Telegram</h1>
        <p class="stub__lede">Скачивайте видео из TikTok, Instagram, YouTube, VK и X — в исходном качестве и без водяных знаков.</p>
        <a class="stub__cta" href="https://t.me/SaveFastVideoFreebot?startapp">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21.9 4.6 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L6.1 13 1.2 11.5c-1-.3-1.1-1 .2-1.5L20.6 2.6c.9-.3 1.6.2 1.3 2z"/></svg>
          Открыть в Telegram
        </a>
        <div class="stub__alt">
          <a href="https://t.me/SaveAsVideoFreebot">@SaveAsVideoFreebot</a>
          <span aria-hidden="true">·</span>
          <a href="https://t.me/SaveVideoProbot">@SaveVideoProbot</a>
        </div>
        <button class="stub__web" id="bot-login" type="button">Открыть в браузере</button>
        <div class="auth-status" id="auth-status"></div>
      </div>
      <a class="stub__back" href="/">← На сайт</a>
    </section>

    <main class="app" id="app" hidden>
      <!-- ГЛАВНАЯ -->
      <section class="screen" data-screen="home">
        <div class="hero">
          <div class="hero__top">
            <div class="hero__ava" id="h-ava">S</div>
            <div class="hero__name" id="h-name">SaveFastVideo</div>
