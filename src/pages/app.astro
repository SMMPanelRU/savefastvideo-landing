    <script is:inline define:vars={{ tgAnalyticsToken }}>
      (function () {
        if (!tgAnalyticsToken) return;
        const load = () => {
          const s = document.createElement('script');
          s.async = true; s.src = 'https://tganalytics.xyz/index.js';
          s.onload = () => { try { window.telegramAnalytics.init({ token: tgAnalyticsToken, appName: 'save_fast_as_video' }); } catch (e) {} };
          document.head.appendChild(s);
        };
        // после load: tganalytics.xyz бывает отдаёт 200 без тела и держит событие load
        if (document.readyState === 'complete') load(); else window.addEventListener('load', load, { once: true });
      })();
    </script>
    <script is:inline define:vars={{ BRANDS }}>
      (function () {
        const tg = window.Telegram && window.Telegram.WebApp;
        const inTg = !!(tg && tg.initData);
        const $ = (s, r) => (r || document).querySelector(s);
        const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
        const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const QL = { '1080': '1080p', '720': '720p', '480': '480p', audio: 'MP3' };
        const PLAT_RU = { 'Twitter/X': 'X', VK: 'ВКонтакте', OK: 'Одноклассники', Unknown: 'Видео' };
        const SUBP = { vk: 'VK', youtube: 'YouTube' };
        const IC = {
          chev: '<svg class="i" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg>',
          vid: '<svg class="i" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3z"/></svg>',
          hist: '<svg class="i" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg>',
          bell: '<svg class="i" viewBox="0 0 24 24"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>',
          tg: '<svg class="i" viewBox="0 0 24 24"><path d="m21 4-18 7 6 2 2 6 3-4 5 4z"/><path d="m9 13 8-6"/></svg>',
          x: '<svg class="i" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>',
          warn: '<svg class="i" viewBox="0 0 24 24"><path d="M12 3 2 20h20z"/><path d="M12 10v4M12 17h.01"/></svg>',
        };
        const brand = (p) => {
          const b = BRANDS[p];
          return b ? '<span class="cell__ic cell__ic--brand"><svg viewBox="0 0 24 24"><path fill="' + b.c + '" d="' + b.p + '"/></svg></span>' : '<span class="cell__ic">' + IC.vid + '</span>';
        };

        // ── Telegram chrome ───────────────────────────────────────────
        if (tg) {
          try {
            tg.ready(); tg.expand();
            tg.setHeaderColor && tg.setHeaderColor('#f2f4f8');
            tg.setBackgroundColor && tg.setBackgroundColor('#f2f4f8');
            tg.setBottomBarColor && tg.setBottomBarColor('#f2f4f8');
            tg.disableVerticalSwipes && tg.disableVerticalSwipes();
          } catch (e) {}
        }
        const haptic = (t) => { try { inTg && tg.HapticFeedback && (t === 'ok' || t === 'err' ? tg.HapticFeedback.notificationOccurred(t === 'ok' ? 'success' : 'error') : tg.HapticFeedback.impactOccurred(t || 'light')); } catch (e) {} };

        let toastT;
        const toast = (msg, err) => {
          const t = $('#toast'); t.textContent = msg; t.className = 'toast on' + (err ? ' toast--err' : '');
          clearTimeout(toastT); toastT = setTimeout(() => { t.className = 'toast' + (err ? ' toast--err' : ''); }, 2600);
          haptic(err ? 'err' : 'ok');
        };

        // ── API ───────────────────────────────────────────────────────
        let token = null;
        const SKEY = 'sfv_session';
        const loadSession = () => { try { return JSON.parse(localStorage.getItem(SKEY) || 'null'); } catch (e) { return null; } };
        const saveSession = (s) => { try { s ? localStorage.setItem(SKEY, JSON.stringify(s)) : localStorage.removeItem(SKEY); } catch (e) {} };
        const api = async (path, o) => {
          o = o || {};
          const headers = Object.assign({ 'Content-Type': 'application/json' }, token ? { Authorization: 'Bearer ' + token } : {});
          try {
            const res = await fetch(path, Object.assign({}, o, { headers }));
            let data = null; try { data = await res.json(); } catch (e) {}
            return { ok: res.ok, status: res.status, data: data || {} };
          } catch (e) { return { ok: false, status: 0, data: { message: 'Нет связи с сервером' } }; }
        };

        // ── state ─────────────────────────────────────────────────────
        const S = { me: null, history: null, subs: null, admin: null, dlQ: '720', hFilter: 'all' };

        // ── navigation ────────────────────────────────────────────────
        const stack = [];
        const show = (name, push) => {
          const cur = ($('.screen:not([hidden])') || {}).dataset;
          if (push !== false && cur && cur.screen !== name) stack.push(cur.screen);
          $$('.screen').forEach((s) => { s.hidden = s.dataset.screen !== name; });
          const tab = name === 'admin' ? 'more' : name;
          $$('#nav button').forEach((b) => { if (b.dataset.go === tab) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current'); });
          window.scrollTo(0, 0);
          if (inTg && tg.BackButton) { try { name === 'home' ? tg.BackButton.hide() : tg.BackButton.show(); } catch (e) {} }
          if (name === 'history') renderHistory();
          if (name === 'subs') renderSubs();
          if (name === 'admin') loadAdmin();
        };
        document.addEventListener('click', (e) => {
          const g = e.target.closest('[data-go]');
          if (g) { haptic(); if (g.closest('#nav')) stack.length = 0; show(g.dataset.go); }
        });
        if (inTg && tg.BackButton) {
          try { tg.BackButton.onClick(() => { if (!sheetClose()) show(stack.pop() || 'home', false); }); } catch (e) {}
        }

        // ── sheet ─────────────────────────────────────────────────────
        const sheetOpen = (html) => {
          $('#sheet-body').innerHTML = html;
          $('#sheet-bg').hidden = false; $('#sheet').hidden = false;
          requestAnimationFrame(() => { $('#sheet-bg').classList.add('on'); $('#sheet').classList.add('on'); });
          if (inTg && tg.BackButton) try { tg.BackButton.show(); } catch (e) {}
        };
        const sheetClose = () => {
          if ($('#sheet').hidden) return false;
          $('#sheet-bg').classList.remove('on'); $('#sheet').classList.remove('on');
          setTimeout(() => { $('#sheet-bg').hidden = true; $('#sheet').hidden = true; }, 260);
          if (inTg && tg.BackButton && ($('.screen:not([hidden])') || {}).dataset?.screen === 'home') try { tg.BackButton.hide(); } catch (e) {}
          return true;
        };
        $('#sheet-bg').addEventListener('click', sheetClose);

        // ── helpers ───────────────────────────────────────────────────
        const fmtTime = (iso) => { const d = new Date(String(iso).replace(' ', 'T') + 'Z'); return isNaN(d) ? '' : d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }); };
        const dayLabel = (iso) => {
          const d = new Date(String(iso).replace(' ', 'T') + 'Z'); if (isNaN(d)) return '';
          const t = new Date(); const y = new Date(); y.setDate(t.getDate() - 1);
          if (d.toDateString() === t.toDateString()) return 'Сегодня';
          if (d.toDateString() === y.toDateString()) return 'Вчера';
          return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
        };
        const host = (u) => { try { return new URL(u).hostname.replace(/^www\.|^m\./, ''); } catch (e) { return u; } };
        const plural = (n, a, b, c) => { n = Math.abs(n) % 100; const n1 = n % 10; return n > 10 && n < 20 ? c : n1 > 1 && n1 < 5 ? b : n1 === 1 ? a : c; };
        const setSeg = (el, q) => $$('button', el).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.q === q)));
        const empty = (icon, title, text) => '<div class="empty"><div class="empty__ic">' + icon + '</div><b>' + title + '</b>' + text + '</div>';
        const skelCells = (n) => Array.from({ length: n }, () => '<div class="cell"><span class="cell__ic sk"></span><span class="cell__body"><span class="sk" style="height:14px;width:60%"></span><span class="sk" style="height:11px;width:40%;margin-top:6px"></span></span></div>').join('');
        const skel = (n) => '<div class="card">' + Array.from({ length: n }, () => '<div class="cell"><span class="cell__ic sk"></span><span class="cell__body"><span class="sk" style="height:14px;width:60%"></span><span class="sk" style="height:11px;width:40%;margin-top:6px"></span></span></div>').join('') + '</div>';

        const histCell = (it) => {
          const title = it.title && !/^-?\d+_\d+\.\w+$|^[\w-]+\.(mp4|jpg|mp3|webm)$/i.test(it.title) ? it.title : host(it.url);
          const plat = PLAT_RU[it.platform] || it.platform || 'Видео';
          const pill = it.status === 'ok' ? '<span class="pill pill--ok">Скачано</span>' : '<span class="pill pill--fail">Ошибка</span>';
          return '<button class="cell" type="button" data-again="' + esc(it.url) + '">' + brand(it.platform) +
            '<span class="cell__body"><span class="cell__t">' + esc(title) + '</span><span class="cell__s">' + esc(plat) + (it.quality ? ' · ' + esc(QL[it.quality] || it.quality) : '') + ' · ' + fmtTime(it.created_at) + '</span></span>' +
            '<span class="cell__end">' + pill + '</span></button>';
        };

        // ── render: home ──────────────────────────────────────────────
        const renderHome = () => {
          const m = S.me || {}; const u = m.user || {};
          const name = u.first_name || (u.username ? '@' + u.username : 'Гость');
          $('#h-ava').textContent = (name.replace('@', '')[0] || 'S').toUpperCase();
          $('#h-name').textContent = name;
          $('#h-q').textContent = QL[m.quality] || '720p';
          $('#h-count').textContent = m.downloads != null ? Number(m.downloads).toLocaleString('ru-RU') : '—';
          const sc = m.subs_count || 0;
          if (m.subs_count != null) { $('#h-subs').hidden = false; $('#h-subs').textContent = sc + ' ' + plural(sc, 'подписка', 'подписки', 'подписок'); }
          $('#admin-entry').hidden = !m.is_admin;
          $('#more-sub').textContent = u.username ? '@' + u.username : 'Настройки и помощь';
          setSeg($('#set-q'), m.quality || '720');
          const r = $('#recent');
          if (!S.history) { r.innerHTML = skelCells(2); return; }
          const items = S.history.slice(0, 3);
          r.innerHTML = items.length ? items.map(histCell).join('') : empty(IC.hist, 'Пока пусто', 'Скачайте первое видео — оно появится здесь');
        };

        // ── render: history ───────────────────────────────────────────
        const renderHistory = () => {
          const box = $('#history');
          if (!S.history) { box.innerHTML = skel(4); return; }
          const all = S.history;
          $$('#h-filter .chip').forEach((c) => {
            const n = c.dataset.f === 'all' ? all.length : all.filter((i) => i.status === c.dataset.f).length;
            c.innerHTML = { all: 'Все', ok: 'Скачано', fail: 'Ошибки' }[c.dataset.f] + ' <b>' + n + '</b>';
            c.setAttribute('aria-pressed', String(c.dataset.f === S.hFilter));
          });
          const list = S.hFilter === 'all' ? all : all.filter((i) => i.status === S.hFilter);
          if (!list.length) { box.innerHTML = '<div class="card">' + empty(IC.hist, all.length ? 'Ничего не найдено' : 'История пуста', all.length ? 'В этом фильтре нет записей' : 'Здесь будут все ваши скачивания') + '</div>'; return; }
          let html = '', day = null, open = false;
          list.forEach((it) => {
            const d = dayLabel(it.created_at);
            if (d !== day) { if (open) html += '</div>'; html += '<div class="day">' + esc(d) + '</div><div class="card">'; open = true; day = d; }
            html += histCell(it);
          });
          if (open) html += '</div>';
          box.innerHTML = html;
        };
        $('#h-filter').addEventListener('click', (e) => { const c = e.target.closest('.chip'); if (!c) return; haptic(); S.hFilter = c.dataset.f; renderHistory(); });

        // ── render: subs ──────────────────────────────────────────────
        const renderSubs = () => {
          const box = $('#subs');
          if (!S.subs) { box.innerHTML = skel(2); return; }
          $('#subs-title').textContent = 'Мои подписки' + (S.subs.length ? ' · ' + S.subs.length : '');
          if (!S.subs.length) { box.innerHTML = '<div class="card">' + empty(IC.bell, 'Нет подписок', 'Добавьте YouTube-канал или страницу VK — новые видео будут приходить в чат') + '</div>'; return; }
          box.innerHTML = '<div class="card">' + S.subs.map((s) => {
            const p = SUBP[s.platform] || s.platform;
            return '<div class="cell">' + brand(p) + '<span class="cell__body"><span class="cell__t">' + esc(s.account_title || s.account_handle || s.account_id) + '</span><span class="cell__s">' + esc(p) + (s.account_handle ? ' · ' + esc(s.account_handle) : '') + '</span></span>' +
              '<button class="field__btn" type="button" data-unsub="' + s.id + '" aria-label="Отписаться">' + IC.x + '</button></div>';
          }).join('') + '</div>';
        };

        // ── render: admin ─────────────────────────────────────────────
        const renderAdmin = () => {
          const a = S.admin;
          if (!a) { $('#a-tiles').innerHTML = Array.from({ length: 6 }, () => '<div class="tile"><div class="sk" style="height:24px;width:60%"></div><div class="sk" style="height:11px;width:80%;margin-top:8px"></div></div>').join(''); $('#a-channels').innerHTML = ''; $('#a-plats').innerHTML = ''; return; }
          const st = a.stats; const n = (v) => Number(v || 0).toLocaleString('ru-RU');
          const tiles = [
            [n(st.users), 'Пользователей'], ['+' + n(st.new_1d), 'Новых за сутки'], ['+' + n(st.new_7d), 'Новых за 7 дней'],
            [n(st.downloads), 'Скачиваний всего'], [n(st.ok_1d), 'Успешно за сутки', 'ok'], [n(st.fail_1d), 'Ошибок за сутки', 'fail'],
          ];
          $('#a-tiles').innerHTML = tiles.map((t) => '<div class="tile' + (t[2] ? ' tile--' + t[2] : '') + '"><div class="tile__v">' + t[0] + '</div><div class="tile__l">' + t[1] + '</div></div>').join('');
          const pl = st.platforms_7d || []; const max = Math.max(1, ...pl.map((p) => p.count));
          const subsLine = Object.keys(st.subs || {}).map((k) => (SUBP[k] || k) + ': ' + st.subs[k]).join(' · ');
          $('#a-plats').innerHTML = (pl.length ? pl.map((p) => {
            const b = BRANDS[p.platform];
            return '<div class="bar"><span class="bar__ic">' + (b ? '<svg viewBox="0 0 24 24"><path fill="' + b.c + '" d="' + b.p + '"/></svg>' : '') + '</span><span><span style="display:flex;justify-content:space-between"><span>' + esc(PLAT_RU[p.platform] || p.platform) + '</span></span><span class="bar__track" style="display:block;margin-top:5px"><span class="bar__fill" style="display:block;width:' + Math.round(p.count / max * 100) + '%"></span></span></span><b>' + n(p.count) + '</b></div>';
          }).join('') : '<p class="hint" style="margin:14px 0 4px">Данные появятся после первых скачиваний</p>') +
            (subsLine ? '<p class="hint" style="text-align:left;margin-top:14px">Подписки пользователей на каналы: ' + esc(subsLine) + '</p>' : '');
          const ch = a.channels || [];
          const active = ch.filter((c) => c.active).length;
          $('#a-ch-title').textContent = 'Каналы · ' + active + ' из ' + ch.length;
          $('#a-channels').innerHTML = ch.length ? ch.map((c) => {
            const broken = c.bot_ok === false;
            const ava = c.photo ? '<img class="ch-ava" src="' + c.photo + '" alt="">' : '<span class="ch-ava ch-ava--l">' + esc((c.username || '?').trim()[0] || '?').toUpperCase() + '</span>';
            const members = c.members != null ? n(c.members) + ' ' + plural(c.members, 'подписчик', 'подписчика', 'подписчиков') : '';
            const why = c.reason === 'not_admin' ? 'Бот не админ канала' : 'Бота нет в канале';
            const sub = broken
              ? '<span style="color:var(--warning)">' + why + '</span>'
              : (c.active ? 'Активен' : 'На паузе') + (members ? ' · ' + members : '');
            return '<div class="cell"><button class="cell" style="padding:0;flex:1;min-width:0" type="button" data-ch="' + c.id + '"><span class="ch-wrap">' + ava + (broken ? '<span class="ch-warn">!</span>' : '') + '</span><span class="cell__body"><span class="cell__t">' + esc(c.username) + '</span><span class="cell__s">' + sub + '</span></span></button>' +
              '<button class="sw" type="button" role="switch" aria-checked="' + (c.active ? 'true' : 'false') + '" aria-label="Включить канал" data-toggle="' + c.id + '"></button></div>';
          }).join('') : empty(IC.tg, 'Каналов нет', 'Добавьте канал — бот начнёт просить на него подписаться');
        };

        // ── loaders ───────────────────────────────────────────────────
        const loadAll = async () => {
          renderHome();
          const [me, h, s] = await Promise.all([api('/api/me'), api('/api/history?limit=100'), api('/api/subscriptions')]);
          if (me.status === 401) return relogin();
          if (me.ok) { S.me = me.data; S.dlQ = me.data.quality || '720'; setSeg($('#dl-q'), S.dlQ); }
          S.history = h.ok ? (h.data.items || []) : [];
          S.subs = s.ok ? (s.data.items || []) : [];
          renderHome();
          const cur = ($('.screen:not([hidden])') || {}).dataset.screen;
          if (cur === 'history') renderHistory();
          if (cur === 'subs') renderSubs();
        };
        const loadAdmin = async (fresh) => {
          renderAdmin();
          const r = await api('/api/admin/overview' + (fresh ? '?fresh=1' : ''));
          if (!r.ok) { toast(r.status === 403 ? 'Нет доступа' : 'Не удалось загрузить', true); return; }
          S.admin = r.data; renderAdmin();
        };

        // ── actions ───────────────────────────────────────────────────
        const paste = async () => {
          haptic();
          let txt = '';
          try { txt = await navigator.clipboard.readText(); } catch (e) {}
          if (!txt && inTg && tg.readTextFromClipboard) {
            try { txt = await new Promise((res) => tg.readTextFromClipboard((t) => res(t || ''))); } catch (e) {}
          }
          const inp = $('#dl-url');
          if (txt) { inp.value = txt.trim(); } else { toast('Вставьте ссылку в поле вручную'); }
          if (($('.screen:not([hidden])') || {}).dataset.screen !== 'home') show('home');
          inp.focus();
        };
        const send = async (url, q) => {
          url = (url || '').trim();
          if (!url) { $('#dl-url').focus(); toast('Вставьте ссылку на видео', true); return; }
          const b = $('#dl-go'); b.disabled = true; const old = b.innerHTML; b.innerHTML = '<span class="spin"></span> Отправляю…';
          const r = await api('/api/send', { method: 'POST', body: JSON.stringify({ url, quality: q || S.dlQ }) });
          b.disabled = false; b.innerHTML = old;
          if (r.ok) {
            $('#dl-url').value = '';
            if (r.data.gate) {
              haptic('ok');
              sheetOpen('<h3>Остался один шаг</h3><p class="sub">Подпишитесь на канал в чате с ботом — и видео сразу придёт.</p><button class="btn" type="button" id="gate-go">Перейти в чат</button>');
              $('#gate-go').addEventListener('click', () => { try { tg.close(); } catch (e) { sheetClose(); } });
            } else {
              toast('Готово! Видео придёт в чат');
              if (inTg) setTimeout(() => { try { tg.close(); } catch (e) {} }, 1200);
            }
            setTimeout(loadAll, 4000);
          } else {
            toast((r.data && r.data.message) || 'Не получилось отправить — попробуйте ещё раз', true);
          }
        };

        document.addEventListener('click', async (e) => {
          const t = e.target.closest('[data-act],[data-q],[data-again],[data-unsub],[data-toggle],[data-ch]');
          if (!t) return;
          if (t.dataset.act === 'paste') return paste();
          if (t.dataset.act === 'quality') { haptic(); return show('more'); }
          if (t.dataset.act === 'admin-refresh') { haptic(); S.admin = null; return loadAdmin(true); }
          if (t.dataset.act === 'ch-add') return openAddChannel();
          if (t.dataset.q && t.closest('#dl-q')) { haptic(); S.dlQ = t.dataset.q; setSeg($('#dl-q'), S.dlQ); return; }
          if (t.dataset.q && t.closest('#set-q')) {
            haptic(); setSeg($('#set-q'), t.dataset.q);
            const r = await api('/api/quality', { method: 'POST', body: JSON.stringify({ quality: t.dataset.q }) });
            if (r.ok) { S.me && (S.me.quality = t.dataset.q); S.dlQ = t.dataset.q; setSeg($('#dl-q'), S.dlQ); renderHome(); toast('Качество: ' + QL[t.dataset.q]); }
            else toast('Не удалось сохранить', true);
            return;
          }
          if (t.dataset.again) {
            haptic();
            const url = t.dataset.again;
            sheetOpen('<h3>Скачать снова?</h3><p class="sub">' + esc(url) + '</p><div class="lbl">Качество</div><div class="seg" id="again-q">' +
              ['1080', '720', '480', 'audio'].map((q) => '<button type="button" data-aq="' + q + '" aria-pressed="' + (q === S.dlQ) + '">' + QL[q] + '</button>').join('') +
              '</div><button class="btn" type="button" id="again-go">Скачать в чат</button><button class="btn btn--ghost" type="button" id="again-copy">Скопировать ссылку</button>');
            let aq = S.dlQ;
            $('#again-q').addEventListener('click', (ev) => { const x = ev.target.closest('[data-aq]'); if (!x) return; aq = x.dataset.aq; $$('#again-q button').forEach((y) => y.setAttribute('aria-pressed', String(y === x))); haptic(); });
            $('#again-go').addEventListener('click', () => { sheetClose(); send(url, aq); });
            $('#again-copy').addEventListener('click', async () => { try { await navigator.clipboard.writeText(url); toast('Ссылка скопирована'); } catch (er) { toast('Не удалось скопировать', true); } sheetClose(); });
            return;
          }
          if (t.dataset.unsub) {
            const id = Number(t.dataset.unsub);
            const go = async () => {
              const r = await api('/api/subscriptions/remove', { method: 'POST', body: JSON.stringify({ id }) });
              if (r.ok) { S.subs = S.subs.filter((s) => s.id !== id); S.me && (S.me.subs_count = S.subs.length); renderSubs(); renderHome(); toast('Подписка удалена'); }
              else toast('Не удалось отписаться', true);
            };
            if (inTg && tg.showConfirm) tg.showConfirm('Отписаться от этого канала?', (ok) => ok && go()); else go();
            return;
          }
          if (t.dataset.toggle) {
            const id = Number(t.dataset.toggle);
            const on = t.getAttribute('aria-checked') !== 'true';
            t.setAttribute('aria-checked', String(on)); haptic('medium');
            const r = await api('/api/admin/channel', { method: 'POST', body: JSON.stringify({ action: 'toggle', id }) });
            if (!r.ok) { t.setAttribute('aria-checked', String(!on)); toast('Не удалось переключить', true); return; }
            const c = S.admin.channels.find((x) => x.id === id); if (c) c.active = on ? 1 : 0;
            renderAdmin(); toast(on ? 'Канал включён' : 'Канал на паузе');
            return;
          }
          if (t.dataset.ch) {
            const c = S.admin.channels.find((x) => x.id === Number(t.dataset.ch)); if (!c) return;
            haptic();
            sheetOpen('<h3>' + esc(c.username) + '</h3><p class="sub">ID: ' + esc(c.chat_id) + '<br>' + esc(c.url) + (c.bot_ok === false ? '<br><br><span style="color:var(--warning)">Бот не может проверять подписку. Добавьте @SaveFastVideoFreebot администратором канала и включите канал снова.</span>' : (c.members != null ? '<br>' + Number(c.members).toLocaleString('ru-RU') + ' подписчиков' : '')) + '</p>' +
              '<button class="btn btn--ghost" type="button" id="ch-open">Открыть канал</button><button class="btn btn--danger" type="button" id="ch-del">Удалить канал</button>');
            $('#ch-open').addEventListener('click', () => { try { inTg ? tg.openTelegramLink(c.url) : window.open(c.url, '_blank'); } catch (er) { window.open(c.url, '_blank'); } });
            $('#ch-del').addEventListener('click', () => {
              const go = async () => {
                const r = await api('/api/admin/channel', { method: 'POST', body: JSON.stringify({ action: 'delete', id: c.id }) });
                if (r.ok) { sheetClose(); S.admin.channels = S.admin.channels.filter((x) => x.id !== c.id); renderAdmin(); toast('Канал удалён'); } else toast('Не удалось удалить', true);
              };
              if (inTg && tg.showConfirm) tg.showConfirm('Удалить «' + c.username + '» из списка? Это нельзя отменить.', (ok) => ok && go()); else go();
            });
          }
        });

        const openAddChannel = () => {
          haptic();
          sheetOpen('<h3>Новый канал</h3><p class="sub">Бот будет просить подписаться на этот канал. Сначала добавьте бота-проверяльщика админом в канал.</p>' +
            '<div class="lbl">Название</div><div class="field"><input id="nc-title" placeholder="Например, Кино за 5 минут" maxlength="80"></div>' +
            '<div class="lbl">ID канала</div><div class="field"><input id="nc-id" inputmode="numeric" placeholder="-1001234567890"></div>' +
            '<p class="hint" style="text-align:left">Перешлите любой пост канала в @JsonDumpBot — ID будет в поле forward_from_chat.id</p>' +
            '<div class="lbl">Ссылка-приглашение</div><div class="field"><input id="nc-url" inputmode="url" placeholder="https://t.me/+AbCdEf…"></div>' +
            '<button class="btn" type="button" id="nc-go">Добавить канал</button>');
          $('#nc-go').addEventListener('click', async () => {
            const title = $('#nc-title').value.trim(), chat_id = $('#nc-id').value.trim(), url = $('#nc-url').value.trim();
            if (!title || !/^-100\d{5,}$/.test(chat_id) || !/^https:\/\/t\.me\/\S+$/.test(url)) { toast('Проверьте поля: ID начинается с -100, ссылка — https://t.me/…', true); return; }
            const b = $('#nc-go'); b.disabled = true;
            const r = await api('/api/admin/channel', { method: 'POST', body: JSON.stringify({ action: 'add', title, chat_id, url }) });
            b.disabled = false;
            if (r.ok) { sheetClose(); toast('Канал добавлен'); loadAdmin(); }
            else toast(r.status === 409 ? 'Такой канал уже есть' : 'Не удалось добавить', true);
          });
        };

        $('#dl-go').addEventListener('click', () => { haptic('medium'); send($('#dl-url').value); });
        $('#dl-url').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); send($('#dl-url').value); } });
        $('#sub-go').addEventListener('click', async () => {
          const url = $('#sub-url').value.trim();
          if (!url) { toast('Вставьте ссылку на канал', true); return; }
          const b = $('#sub-go'); b.disabled = true; b.innerHTML = '<span class="spin"></span> Проверяю…';
          const r = await api('/api/subscribe', { method: 'POST', body: JSON.stringify({ url }) });
          b.disabled = false; b.textContent = 'Подписаться';
          if (r.ok) { $('#sub-url').value = ''; toast('Подписка добавлена'); const s = await api('/api/subscriptions'); if (s.ok) { S.subs = s.data.items || []; S.me && (S.me.subs_count = S.subs.length); renderSubs(); renderHome(); } }
          else toast((r.data && (r.data.message || (r.data.error === 'bad_url' ? 'Нужна ссылка на YouTube-канал или страницу VK' : ''))) || 'Не удалось подписаться', true);
        });

        // ── boot ──────────────────────────────────────────────────────
        const startApp = () => {
          document.body.classList.remove('is-stub');
          $('#auth').hidden = true; $('#app').hidden = false; $('#nav').hidden = false; $('#nav-fade').hidden = false;
          setSeg($('#dl-q'), S.dlQ);
          show('home', false);
          loadAll();
        };
        const relogin = async () => {
          token = null;
          if (inTg) {
            const r = await api('/api/auth/miniapp', { method: 'POST', body: JSON.stringify({ init_data: tg.initData }) });
            if (r.ok && r.data.token) { token = r.data.token; return loadAll(); }
            toast('Не удалось войти — откройте приложение заново', true);
          } else { saveSession(null); showStub(); }
        };
        const showStub = () => { document.body.classList.add('is-stub'); $('#auth').hidden = false; $('#app').hidden = true; $('#nav').hidden = true; $('#nav-fade').hidden = true; };

        if (inTg) {
          startApp();
          (async () => {
            const r = await api('/api/auth/miniapp', { method: 'POST', body: JSON.stringify({ init_data: tg.initData }) });
            if (r.ok && r.data.token) { token = r.data.token; loadAll(); }
            else { S.history = []; S.subs = []; renderHome(); toast('Не удалось войти — откройте приложение заново', true); }
          })();
        } else {
          const sess = loadSession();
          if (sess && sess.token) { token = sess.token; startApp(); } else showStub();
          // вход в веб-версию через бота (deep-link + поллинг)
          let poll = null;
          const btn = $('#bot-login');
          btn && btn.addEventListener('click', async () => {
            btn.disabled = true; btn.textContent = 'Ожидаю подтверждения…';
            $('#auth-status').textContent = 'Откройте бота и нажмите START — вход подтвердится сам.';
            const r = await api('/api/auth/bot-start', { method: 'POST', body: '{}' });
            if (!r.ok || !r.data.link) { btn.disabled = false; btn.textContent = 'Открыть в браузере'; toast('Сервис входа недоступен', true); return; }
            window.open(r.data.link, '_blank');
            $('#auth-status').innerHTML = 'Код сессии: <b style="color:var(--fg);letter-spacing:2px">' + esc(r.data.short || '—') + '</b><br>Подтвердите вход в боте, если код совпадает.';
            const started = Date.now(); clearInterval(poll);
            poll = setInterval(async () => {
              if (Date.now() - started > 5 * 60 * 1000) { clearInterval(poll); btn.disabled = false; btn.textContent = 'Открыть в браузере'; $('#auth-status').textContent = 'Время вышло — нажмите ещё раз.'; return; }
              const p = await api('/api/auth/bot-poll?code=' + encodeURIComponent(r.data.code));
              if (p.data && p.data.status === 'ok') { clearInterval(poll); token = p.data.token; saveSession({ token, user: p.data.user }); startApp(); }
              else if (p.data && p.data.status === 'expired') { clearInterval(poll); btn.disabled = false; btn.textContent = 'Открыть в браузере'; $('#auth-status').textContent = 'Код истёк — нажмите ещё раз.'; }
            }, 2000);
          });
        }
      })();
    </script>
  </body>
</html>
