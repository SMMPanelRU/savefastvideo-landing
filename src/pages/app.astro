---
// Telegram Mini App — functional UI, not just hints.
// Sends actions to the bot via WebApp.sendData (bot has F.web_app_data handler).
// Analytics: TG Mini Apps Analytics SDK (PUBLIC_TG_ANALYTICS_TOKEN at build time).
const tgAnalyticsToken = import.meta.env.PUBLIC_TG_ANALYTICS_TOKEN || '';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>SaveFastVideo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    {tgAnalyticsToken && (
      <script async src="https://tganalytics.xyz/index.js" type="text/javascript" />
    )}
    <style>
      :root {
        --bg: #0a0a0a;
        --card: #141414;
        --card-2: #1c1c1c;
        --border: #262626;
        --text: #f5f5f5;
        --muted: #8a8a8a;
        --accent: #f97316;
        --accent-h: #fb923c;
        --success: #22c55e;
        --danger: #ef4444;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
        -webkit-tap-highlight-color: transparent;
        padding: 0 16px env(safe-area-inset-bottom, 16px);
      }
      header {
        padding: 28px 0 16px;
        text-align: center;
      }
      header .logo {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      header .logo span { color: var(--accent); }
      header p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14px;
      }
      .tabs {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 4px;
        background: var(--card);
        border-radius: 12px;
        padding: 4px;
        margin-bottom: 20px;
      }
      .tab {
        padding: 10px 8px;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border-radius: 10px;
        color: var(--muted);
        background: transparent;
        border: none;
        font-family: inherit;
        transition: background .15s, color .15s;
      }
      .tab.active {
        color: var(--text);
        background: var(--card-2);
      }
      .pane { display: none; }
      .pane.active { display: block; }
      .field {
        display: block;
        margin-bottom: 16px;
      }
      .field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
      }
      .input, .select {
        width: 100%;
        background: var(--card);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: 16px;
        padding: 14px 16px;
        border-radius: 12px;
        font-family: inherit;
        appearance: none;
        -webkit-appearance: none;
      }
      .input:focus, .select:focus {
        outline: none;
        border-color: var(--accent);
      }
      .input::placeholder {
        color: var(--muted);
      }
      .btn {
        width: 100%;
        background: var(--accent);
        color: #000;
        font-weight: 700;
        font-size: 16px;
        padding: 16px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-family: inherit;
        transition: background .15s, transform .1s;
      }
      .btn:active { transform: scale(0.98); background: var(--accent-h); }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; }
      .quality-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 6px;
        margin-bottom: 16px;
      }
      .quality-row button {
        padding: 10px 6px;
        background: var(--card);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: 13px;
        font-weight: 600;
        border-radius: 10px;
        cursor: pointer;
        font-family: inherit;
        transition: background .15s, border-color .15s;
      }
      .quality-row button.active {
        background: var(--accent);
        color: #000;
        border-color: var(--accent);
      }
      .platforms {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
        margin-bottom: 20px;
      }
      .platform {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 4px;
        text-align: center;
        font-size: 11px;
        color: var(--muted);
      }
      .platform .emoji { font-size: 20px; display: block; margin-bottom: 2px; }
      /* ─── Browser mode: auth + results ─── */
      .auth-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 32px 24px;
        text-align: center;
        margin-top: 8vh;
      }
      .auth-card .icon {
        width: 64px; height: 64px;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--accent), #fbbf24);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 28px; color: #000; font-weight: 800;
        margin-bottom: 16px;
      }
      .auth-card h1 { font-size: 22px; margin: 0 0 8px; letter-spacing: -0.02em; }
      .auth-card p { color: var(--muted); font-size: 14px; margin: 0 0 24px; }
      .btn-tg {
        width: 100%;
        background: #2aabee;
        color: #fff;
        font-weight: 700;
        font-size: 16px;
        padding: 15px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-family: inherit;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      }
      .btn-tg:active { transform: scale(0.98); }
      .btn-tg:disabled { opacity: 0.6; }
      #tg-widget { display: flex; justify-content: center; margin-bottom: 12px; min-height: 0; }
      #tg-widget iframe { border-radius: 12px; }
      .auth-status { font-size: 13px; color: var(--muted); margin-top: 14px; min-height: 18px; }
      .userbar {
        display: flex; align-items: center; justify-content: space-between;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 10px 14px;
        margin-bottom: 16px;
        font-size: 14px;
      }
      .userbar .who { font-weight: 600; }
      .userbar .who span { color: var(--muted); font-weight: 400; }
      .userbar button {
        background: none; border: none; color: var(--muted);
        font-size: 13px; cursor: pointer; font-family: inherit;
        text-decoration: underline; padding: 0;
      }
      .result-item {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 14px;
        margin-top: 10px;
      }
      .result-item .meta { min-width: 0; }
      .result-item .name {
        font-size: 14px; font-weight: 600;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .result-item .size { font-size: 12px; color: var(--muted); }
      .result-item a {
        flex-shrink: 0;
        background: var(--accent); color: #000;
        font-size: 13px; font-weight: 700;
        padding: 10px 14px; border-radius: 10px;
        text-decoration: none;
      }
      .spin {
        display: inline-block; width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
        border-radius: 50%;
        animation: spin .7s linear infinite;
        vertical-align: -2px; margin-right: 6px;
      }
      @keyframes spin { to { transform: rotate(360deg); } }
      .toast {
        position: fixed;
        bottom: 32px;
        left: 16px;
        right: 16px;
        background: var(--success);
        color: #000;
        padding: 14px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity .2s, transform .2s;
        pointer-events: none;
        z-index: 100;
      }
      .toast.show { opacity: 1; transform: translateY(0); }
      .toast.danger { background: var(--danger); color: #fff; }
      footer {
        margin-top: 28px;
        text-align: center;
        color: var(--muted);
        font-size: 12px;
        padding-bottom: 32px;
      }
      footer a { color: var(--muted); text-decoration: underline; }
    </style>
  </head>
  <body>
    <header>
      <div class="logo"><span>▶</span> SaveFastVideo</div>
      <p>Скачивание видео из соцсетей</p>
    </header>

    <!-- BROWSER AUTH (показывается только вне Telegram, до входа) -->
    <section id="auth" class="auth-card" hidden>
      <div class="icon">▶</div>
      <h1>SaveFastVideo</h1>
      <p>Войдите через Telegram — без пароля.<br/>Скачивание видео прямо в браузер.</p>
      <div id="tg-widget"></div>
      <button class="btn-tg" id="bot-login" type="button">
        ✈️ Войти через Telegram
      </button>
      <div class="auth-status" id="auth-status"></div>
      <p style="margin:20px 0 0; font-size:12px;">Или откройте Mini App в нашем боте: <a href="https://t.me/SaveFastVideoFreebot" style="color:var(--accent); text-decoration:none;">@SaveFastVideoFreebot</a></p>
    </section>

    <div class="userbar" id="userbar" hidden>
      <div class="who" id="userbar-name"></div>
      <button type="button" id="logout">Выйти</button>
    </div>

    <div class="tabs" role="tablist">
      <button class="tab active" data-tab="download" type="button">📥 Скачать</button>
      <button class="tab" data-tab="subscribe" type="button">🔔 Подписки</button>
      <button class="tab" data-tab="settings" type="button">🎛 Качество</button>
    </div>

    <!-- DOWNLOAD -->
    <section class="pane active" data-pane="download">
      <div class="field">
        <label for="dl-url">Ссылка на видео</label>
        <input id="dl-url" class="input" type="url" placeholder="https://tiktok.com/@user/video/123..." inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false" />
      </div>
      <div class="field">
        <label>Качество</label>
        <div class="quality-row" id="dl-quality">
          <button type="button" data-q="1080">1080p</button>
          <button type="button" data-q="720" class="active">720p</button>
          <button type="button" data-q="480">480p</button>
          <button type="button" data-q="audio">🎵 MP3</button>
        </div>
      </div>
      <button class="btn" id="dl-submit" type="button">Скачать в чат</button>
      <p style="color:var(--muted); font-size:13px; margin-top:14px; text-align:center;" id="dl-hint">
        Результат придёт сообщением в чат с ботом.
      </p>
      <div id="dl-results"></div>

      <h2 style="font-size:14px; color:var(--muted); margin:24px 0 10px; text-transform:uppercase; letter-spacing:0.04em; font-weight:500;">Поддерживаемые платформы</h2>
      <div class="platforms">
        <div class="platform"><span class="emoji">🟣</span>Instagram</div>
        <div class="platform"><span class="emoji">⚫</span>TikTok</div>
        <div class="platform"><span class="emoji">🔴</span>YouTube</div>
        <div class="platform"><span class="emoji">✖️</span>X / Twitter</div>
        <div class="platform"><span class="emoji">🔵</span>VK</div>
        <div class="platform"><span class="emoji">🧡</span>OK</div>
      </div>
    </section>

    <!-- SUBSCRIBE -->
    <section class="pane" data-pane="subscribe">
      <div class="field">
        <label for="sub-url">Канал YouTube или VK</label>
        <input id="sub-url" class="input" type="url" placeholder="https://youtube.com/@channel  или  https://vk.com/group" inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false" />
      </div>
      <button class="btn" id="sub-submit" type="button">🔔 Подписаться</button>
      <p style="color:var(--muted); font-size:13px; margin-top:14px; text-align:center;">
        Бот будет автоматически присылать новые посты каждые 30 минут.
      </p>
      <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin-top:20px; font-size:14px; color:var(--muted);">
        <strong style="color:var(--text);">Управление подписками</strong><br/>
        Список ваших подписок и удаление — в чате с ботом:<br/>
        <code style="background:var(--card-2); padding:2px 6px; border-radius:4px; color:var(--text);">/subscriptions</code> — список<br/>
        <code style="background:var(--card-2); padding:2px 6px; border-radius:4px; color:var(--text);">/unsubscribe N</code> — отписаться по номеру
      </div>
    </section>

    <!-- SETTINGS -->
    <section class="pane" data-pane="settings">
      <div class="field">
        <label>Качество по умолчанию</label>
        <div class="quality-row" id="settings-quality">
          <button type="button" data-q="1080">1080p</button>
          <button type="button" data-q="720" class="active">720p</button>
          <button type="button" data-q="480">480p</button>
          <button type="button" data-q="audio">🎵 MP3</button>
        </div>
        <p style="color:var(--muted); font-size:13px; margin:8px 0 0;">
          Сохранится для всех будущих скачиваний — как в чате через меню → 🎛 Качество.
        </p>
      </div>
      <button class="btn" id="settings-submit" type="button">💾 Сохранить качество</button>

      <div style="background:var(--card); border:1px solid var(--border); border-radius:12px; padding:14px 16px; margin-top:24px; font-size:14px; color:var(--muted); line-height:1.6;">
        <strong style="color:var(--text); display:block; margin-bottom:6px;">🎙 Видео в текст</strong>
        Пришли голосовое сообщение, аудиофайл или видео-кружок прямо в чат с ботом — он распознает речь (faster-whisper локально, поддержка ru/en/40+ языков) и пришлёт текст.
      </div>
    </section>

    <div id="toast" class="toast"></div>

    <footer>
      <a href="https://t.me/SaveFastVideoFreebot">@SaveFastVideoFreebot</a>
      ·
      <a href="/">Сайт</a>
    </footer>

    <script is:inline define:vars={{ tgAnalyticsToken }}>
      function _initTgAnalytics() {
        if (!tgAnalyticsToken || !window.telegramAnalytics) return;
        try {
          window.telegramAnalytics.init({ token: tgAnalyticsToken, appName: 'save_fast_as_video' });
        } catch (e) { console.warn('tga init failed', e); }
      }
      if (window.telegramAnalytics) {
        _initTgAnalytics();
      } else {
        let tries = 0;
        const iv = setInterval(() => {
          if (window.telegramAnalytics || tries++ > 50) {
            clearInterval(iv);
            _initTgAnalytics();
          }
        }, 100);
      }
    </script>

    <script is:inline>
      (function () {
        const tg = window.Telegram && window.Telegram.WebApp;
        const inTg = !!tg && tg.initData !== undefined && tg.initData !== '';

        if (tg) {
          try {
            tg.ready();
            tg.expand();
            // theme adapt
            const tp = tg.themeParams || {};
            if (tp.bg_color) document.documentElement.style.setProperty('--bg', tp.bg_color);
            if (tp.secondary_bg_color) document.documentElement.style.setProperty('--card', tp.secondary_bg_color);
            if (tp.text_color) document.documentElement.style.setProperty('--text', tp.text_color);
            if (tp.hint_color) document.documentElement.style.setProperty('--muted', tp.hint_color);
            if (tp.button_color) {
              document.documentElement.style.setProperty('--accent', tp.button_color);
              if (tp.button_text_color) {
                // ensure btn text contrasts
              }
            }
          } catch (e) {}
        }

        // helpers
        const $ = (s, root) => (root || document).querySelector(s);
        const $$ = (s, root) => Array.from((root || document).querySelectorAll(s));
        const haptic = (style) => {
          if (inTg && tg.HapticFeedback) {
            try { tg.HapticFeedback.impactOccurred(style || 'light'); } catch (e) {}
          }
        };
        const toast = (msg, danger) => {
          const t = $('#toast');
          t.textContent = msg;
          t.classList.toggle('danger', !!danger);
          t.classList.add('show');
          setTimeout(() => t.classList.remove('show'), 2400);
        };

        // tabs
        $$('.tab').forEach(btn => {
          btn.addEventListener('click', () => {
            haptic('light');
            const tab = btn.getAttribute('data-tab');
            $$('.tab').forEach(b => b.classList.toggle('active', b === btn));
            $$('.pane').forEach(p => p.classList.toggle('active', p.getAttribute('data-pane') === tab));
            if (window.telegramAnalytics) {
              try { window.telegramAnalytics.event('tab_switch', { tab }); } catch (e) {}
            }
          });
        });

        // quality buttons (download tab & settings tab)
        const wireQualityGroup = (groupSel) => {
          const group = $(groupSel);
          if (!group) return;
          $$('button', group).forEach(btn => {
            btn.addEventListener('click', () => {
              haptic('light');
              $$('button', group).forEach(b => b.classList.toggle('active', b === btn));
            });
          });
        };
        wireQualityGroup('#dl-quality');
        wireQualityGroup('#settings-quality');

        const getActiveQuality = (groupSel) => {
          const active = $(groupSel + ' button.active');
          return active ? active.getAttribute('data-q') : '720';
        };

        // ─── Browser auth (вне Telegram) ─────────────────────────────────
        const BOT_USERNAME = 'SaveFastVideoFreebot';
        const SESSION_KEY = 'sfv_session';
        let session = null; // {token, user}

        const loadSession = () => {
          try { return JSON.parse(localStorage.getItem(SESSION_KEY) || 'null'); }
          catch (e) { return null; }
        };
        const saveSession = (s) => {
          session = s;
          if (s) localStorage.setItem(SESSION_KEY, JSON.stringify(s));
          else localStorage.removeItem(SESSION_KEY);
        };

        const api = async (path, opts) => {
          const o = opts || {};
          const headers = Object.assign(
            { 'Content-Type': 'application/json' },
            session ? { 'Authorization': 'Bearer ' + session.token } : {},
            o.headers || {}
          );
          const res = await fetch(path, Object.assign({}, o, { headers }));
          let data = null;
          try { data = await res.json(); } catch (e) {}
          if (res.status === 401) { saveSession(null); setMode(); }
          return { ok: res.ok, status: res.status, data };
        };

        const showBrowserApp = () => {
          $('#auth').hidden = true;
          $('#userbar').hidden = false;
          const u = session.user || {};
          $('#userbar-name').innerHTML =
            '👤 ' + (u.first_name || 'Пользователь') +
            (u.username ? ' <span>@' + u.username + '</span>' : '');
          document.querySelector('.tabs').style.display = '';
          $$('.pane').forEach(p => p.style.display = '');
          $('#dl-submit').textContent = '⬇️ Скачать';
          $('#dl-hint').textContent = 'Файл скачается прямо в браузер.';
        };

        const showAuthGate = () => {
          $('#auth').hidden = false;
          $('#userbar').hidden = true;
          document.querySelector('.tabs').style.display = 'none';
          $$('.pane').forEach(p => p.style.display = 'none');
        };

        const setMode = () => {
          if (inTg) return; // Mini App — всё как было
          if (session) showBrowserApp();
          else showAuthGate();
        };

        // Telegram Login Widget (требует /setdomain у BotFather; если домен
        // не привязан — виджет просто не отрисуется, останется кнопка бота)
        window.onTelegramAuth = async (user) => {
          const r = await api('/api/auth/telegram', { method: 'POST', body: JSON.stringify(user) });
          if (r.ok && r.data && r.data.token) {
            saveSession({ token: r.data.token, user: r.data.user });
            setMode();
            toast('Добро пожаловать, ' + (r.data.user.first_name || '') + '!');
          } else {
            toast('Не удалось войти — попробуй через бота', true);
          }
        };

        const mountWidget = () => {
          const s = document.createElement('script');
          s.src = 'https://telegram.org/js/telegram-widget.js?22';
          s.setAttribute('data-telegram-login', BOT_USERNAME);
          s.setAttribute('data-size', 'large');
          s.setAttribute('data-radius', '12');
          s.setAttribute('data-onauth', 'onTelegramAuth(user)');
          s.setAttribute('data-request-access', 'write');
          $('#tg-widget').appendChild(s);
        };

        // Вход через бота (deep-link + поллинг) — работает всегда
        let pollTimer = null;
        $('#bot-login') && $('#bot-login').addEventListener('click', async () => {
          const btn = $('#bot-login');
          btn.disabled = true;
          btn.innerHTML = '<span class="spin"></span> Ожидаю подтверждения…';
          $('#auth-status').textContent = 'Открой бота и нажми START — вход подтвердится сам.';
          const r = await api('/api/auth/bot-start', { method: 'POST', body: '{}' });
          if (!r.ok || !r.data || !r.data.link) {
            btn.disabled = false;
            btn.textContent = '✈️ Войти через Telegram';
            toast('Сервис входа недоступен, попробуй позже', true);
            return;
          }
          window.open(r.data.link, '_blank');
          const code = r.data.code;
          $('#auth-status').innerHTML =
            'Код этой сессии: <b style="color:var(--text); letter-spacing:2px;">' +
            (r.data.short || '—') +
            '</b><br/>Открой бота и подтверди вход, если код совпадает.';
          const started = Date.now();
          clearInterval(pollTimer);
          pollTimer = setInterval(async () => {
            if (Date.now() - started > 5 * 60 * 1000) {
              clearInterval(pollTimer);
              btn.disabled = false;
              btn.textContent = '✈️ Войти через Telegram';
              $('#auth-status').textContent = 'Время вышло — нажми ещё раз.';
              return;
            }
            const p = await api('/api/auth/bot-poll?code=' + code);
            if (p.data && p.data.status === 'ok') {
              clearInterval(pollTimer);
              saveSession({ token: p.data.token, user: p.data.user });
              setMode();
              toast('Добро пожаловать, ' + (p.data.user.first_name || '') + '!');
            } else if (p.data && p.data.status === 'expired') {
              clearInterval(pollTimer);
              btn.disabled = false;
              btn.textContent = '✈️ Войти через Telegram';
              $('#auth-status').textContent = 'Код устарел — нажми ещё раз.';
            }
          }, 2000);
        });

        $('#logout') && $('#logout').addEventListener('click', () => {
          saveSession(null);
          setMode();
        });

        // ─── Отправка действий: Mini App → sendData, браузер → API ───────
        const sendToBot = (payload) => {
          const json = JSON.stringify(payload);
          try {
            tg.sendData(json); // sendData auto-closes the mini-app in TG client
          } catch (e) {
            console.error('sendData failed', e);
            toast('Не удалось отправить — открой бот вручную', true);
          }
        };

        const fmtSize = (bytes) => {
          if (!bytes) return '';
          const mb = bytes / 1048576;
          return mb >= 1 ? mb.toFixed(1) + ' MB' : Math.round(bytes / 1024) + ' KB';
        };

        const browserDownload = async (url, quality) => {
          const btn = $('#dl-submit');
          btn.disabled = true;
          btn.innerHTML = '<span class="spin"></span> Скачиваю…';
          $('#dl-results').innerHTML = '';
          try {
            const r = await api('/api/download', {
              method: 'POST',
              body: JSON.stringify({ url, quality }),
            });
            if (!r.ok) {
              toast((r.data && r.data.message) || 'Не удалось скачать', true);
              return;
            }
            const items = (r.data && r.data.items) || [];
            const box = $('#dl-results');
            items.forEach((it, i) => {
              const row = document.createElement('div');
              row.className = 'result-item';
              row.innerHTML =
                '<div class="meta"><div class="name">' +
                (it.filename || 'файл ' + (i + 1)) +
                '</div><div class="size">' + fmtSize(it.size) + '</div></div>';
              const a = document.createElement('a');
              a.href = '/api/file/' + it.token;
              a.textContent = '⬇️ Сохранить';
              a.setAttribute('download', it.filename || '');
              row.appendChild(a);
              box.appendChild(row);
            });
            if (items.length === 1) {
              // один файл — сразу дёргаем скачивание
              const a = box.querySelector('a');
              if (a) a.click();
            }
            toast(items.length > 1 ? 'Готово: ' + items.length + ' файла(ов)' : 'Готово!');
          } finally {
            btn.disabled = false;
            btn.textContent = '⬇️ Скачать';
          }
        };

        // DOWNLOAD submit
        $('#dl-submit').addEventListener('click', () => {
          const url = $('#dl-url').value.trim();
          if (!url) {
            haptic('medium');
            toast('Вставь ссылку на видео', true);
            return;
          }
          haptic('medium');
          if (window.telegramAnalytics) {
            try { window.telegramAnalytics.event('download_submit', { quality: getActiveQuality('#dl-quality') }); } catch (e) {}
          }
          const quality = getActiveQuality('#dl-quality');
          if (inTg) {
            sendToBot({ v: 1, type: 'download', url, quality });
          } else {
            browserDownload(url, quality);
          }
        });

        // SUBSCRIBE submit
        $('#sub-submit').addEventListener('click', async () => {
          const url = $('#sub-url').value.trim();
          if (!url) {
            haptic('medium');
            toast('Вставь ссылку на канал', true);
            return;
          }
          haptic('medium');
          if (window.telegramAnalytics) {
            try { window.telegramAnalytics.event('subscribe_submit'); } catch (e) {}
          }
          if (inTg) {
            sendToBot({ v: 1, type: 'subscribe', url });
            return;
          }
          const r = await api('/api/subscribe', { method: 'POST', body: JSON.stringify({ url }) });
          if (r.ok && r.data && r.data.ok) {
            toast(r.data.added
              ? '✅ Подписка добавлена: ' + (r.data.title || '')
              : 'Ты уже подписан на этот аккаунт');
          } else {
            toast((r.data && r.data.message) || 'Не удалось подписаться', true);
          }
        });

        // SETTINGS submit
        $('#settings-submit').addEventListener('click', async () => {
          haptic('medium');
          const q = getActiveQuality('#settings-quality');
          if (window.telegramAnalytics) {
            try { window.telegramAnalytics.event('quality_set', { quality: q }); } catch (e) {}
          }
          if (inTg) {
            sendToBot({ v: 1, type: 'set_quality', quality: q });
            return;
          }
          const r = await api('/api/quality', { method: 'POST', body: JSON.stringify({ quality: q }) });
          toast(r.ok ? '💾 Качество сохранено' : 'Не удалось сохранить', !r.ok);
        });

        // ─── Init ─────────────────────────────────────────────────────────
        if (!inTg) {
          session = loadSession();
          mountWidget();
          setMode();
          // валидируем сохранённую сессию в фоне
          if (session) {
            api('/api/me').then(r => {
              if (!r.ok) { saveSession(null); setMode(); }
            });
          }
        }

        // BackButton: close on tap
        if (inTg && tg.BackButton) {
          try {
            tg.BackButton.onClick(() => tg.close());
            tg.BackButton.show();
          } catch (e) {}
        }
      })();
    </script>
  </body>
</html>
