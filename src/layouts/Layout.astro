---
const {
  title = 'SaveFastVideo — Скачать видео из Instagram, TikTok, YouTube бесплатно',
  description = 'Бесплатный Telegram-бот для скачивания видео из Instagram (Reels, посты, карусели), TikTok без водяных знаков и YouTube Shorts. Без рекламы, без водяных знаков, мгновенно. Также Twitter/X, VK, Одноклассники.',
  ogImage = '/og-default.png',
  canonical,
} = Astro.props;

const url = canonical || new URL(Astro.url.pathname, Astro.site).toString();
import '../styles/global.css';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="SaveFastVideo" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- schema.org SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'SaveFastVideo',
      operatingSystem: 'Telegram',
      applicationCategory: 'MultimediaApplication',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', ratingCount: '1245' },
      url: 'https://save.smoservice.media',
      description,
    })} />
  </head>
  <body class="antialiased min-h-screen flex flex-col">
    <header class="hdr">
      <div class="wrap hdr__in">
        <a href="/" class="logo" aria-label="SaveFastVideo — главная">
          <span class="logo__save">SAVE</span><span class="logo__rest">FASTVIDEO</span>
        </a>
        <nav class="hdr__nav" aria-label="Основное">
          <a href="/instagram">Instagram</a>
          <a href="/tiktok">TikTok</a>
          <a href="/youtube">YouTube</a>
          <a href="/#platforms">Все платформы</a>
          <a href="/#how">Как скачать</a>
        </nav>
        <a href="https://t.me/SaveFastVideoFreebot" class="btn btn--outline hdr__cta">Открыть бота</a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap ftr__grid">
        <div>
          <a href="/" class="logo" aria-label="SaveFastVideo"><span class="logo__save">SAVE</span><span class="logo__rest">FASTVIDEO</span></a>
          <p class="ftr__about">Бесплатный Telegram-бот для скачивания видео из соцсетей. Без рекламы и водяных знаков.</p>
        </div>
        <div>
          <h4>Инструкции</h4>
          <a href="/instagram">Скачать из Instagram</a>
          <a href="/tiktok">Скачать из TikTok</a>
          <a href="/youtube">Скачать из YouTube</a>
          <a href="/#faq">Частые вопросы</a>
        </div>
        <div>
          <h4>Наши боты</h4>
          <a href="https://t.me/SaveFastVideoFreebot">@SaveFastVideoFreebot</a>
          <a href="https://t.me/SaveAsVideoFreebot">@SaveAsVideoFreebot</a>
          <a href="https://t.me/SaveVideoProbot">@SaveVideoProbot</a>
        </div>
      </div>
      <div class="wrap ftr__bottom">
        <span>© 2026 SaveFastVideo</span>
        <span>Скачивание только публичного контента</span>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  .hdr { position: sticky; top: 0; z-index: 40; background: rgba(14,14,14,.96); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; gap: 32px; height: 72px; }
  .logo { font-weight: 800; font-size: 24px; letter-spacing: -.02em; line-height: 1; white-space: nowrap; }
  .logo__save { color: var(--accent); }
  .logo__rest { color: #5c5c5c; }
  .hdr__nav { display: flex; gap: 24px; font-size: 14px; font-weight: 600; flex: 1; }
  .hdr__nav a { color: var(--text); opacity: .9; transition: color .15s, opacity .15s; }
  .hdr__nav a:hover { color: var(--accent); opacity: 1; }
  .ftr { margin-top: 96px; background: #0a0a0a; border-top: 1px solid #1a1a1a; }
  .ftr__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: 32px; padding-top: 56px; padding-bottom: 40px; }
  .ftr h4 { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); margin-bottom: 14px; }
  .ftr__grid a:not(.logo) { display: block; font-size: 14px; color: var(--text-muted); padding: 5px 0; transition: color .15s; }
  .ftr__grid a:not(.logo):hover { color: var(--accent); }
  .ftr__about { margin-top: 16px; font-size: 14px; line-height: 1.6; color: var(--text-dim); max-width: 300px; }
  .ftr__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; background: linear-gradient(#1f1f1f, #1f1f1f) center top / calc(100% - 32px) 1px no-repeat; padding-top: 20px; padding-bottom: 28px; font-size: 13px; color: var(--text-dim); }
  @media (max-width: 960px) {
    .hdr__nav { display: none; }
    .hdr__in { justify-content: space-between; height: 64px; }
    .ftr__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
        .logo { font-size: 20px; }
    .hdr__cta { height: 38px; padding: 0 14px; font-size: 13px; }
    .ftr__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
